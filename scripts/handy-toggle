#!/usr/bin/env bash
# Control Handy speech-to-text transcription and mirror its state to a marker
# file that the Quickshell toast reads.
#
#   marker values: 0 = idle, 1 = recording, 2 = transcribing
#   handy-toggle start   -> begin recording (idempotent)
#   handy-toggle stop    -> end recording, show "transcribing" then back to idle
#   handy-toggle toggle  -> flip between recording and idle
#
# Handy's SIGUSR2 is a pure toggle, so state can silently drift out of phase
# (the daemon ends up starting Handy instead of stopping it, and vice versa).
# Instead we drive it deterministically through Handy's CLI: "cancel" forces it
# back to idle, then "toggle-transcription" is guaranteed to begin a fresh
# recording. Stopping just toggles, which is correct because a start always
# left Handy recording.
set -u

marker="${XDG_CACHE_HOME:-$HOME/.cache}/handy-recording"
mode="${1:-toggle}"

state=0
if [ -f "$marker" ]; then
  state=$(cat "$marker")
fi

# Deterministic start: cancel any in-flight operation, then begin recording.
start_recording() {
  handy --cancel >/dev/null 2>&1 || true
  handy --toggle-transcription
}

# Stop and transcribe.
stop_recording() {
  handy --toggle-transcription
}

# After "stop", Handy spends a variable amount of time transcribing. Instead of
# a fixed delay, detect when it's actually done:
#   - if Handy saved no WAV (empty recording), it skips persistence entirely;
#   - otherwise it writes a history entry to history.db when transcription ends.
reset_thinking() {
  (
    rec="$HOME/.local/share/com.pais.handy/recordings"
    db="$HOME/.local/share/com.pais.handy/history.db"
    stop_epoch="$(date +%s)"

    # Capture history.db mtime immediately, at stop time, before Handy's
    # transcription writes its entry (fast transcriptions land within ~1s).
    before="$(stat -c %y "$db" 2>/dev/null)" || before=""

    # Give Handy a moment to write the recording WAV (if there was audio).
    sleep 1

    # No audio -> Handy skips persistence; nothing will be transcribed.
    newest="$(ls -t "$rec"/*.wav 2>/dev/null | head -n1)"
    if [ -z "$newest" ] || [ "$(stat -c %Y "$newest" 2>/dev/null)" -lt "$stop_epoch" ]; then
      if [ "$(cat "$marker" 2>/dev/null)" = "2" ]; then
        printf '0\n' > "$marker"
      fi
      exit 0
    fi

    # Real transcription: done when a history entry is saved (history.db mtime
    # changes from what it was at stop). Bail early if a new recording starts.
    i=0
    while [ "$i" -lt 30 ]; do # ~6s safety net (only hit if no history entry)
      sleep 0.2
      [ "$(cat "$marker" 2>/dev/null)" != "2" ] && exit 0
      if [ -n "$before" ] && [ "$(stat -c %y "$db" 2>/dev/null)" != "$before" ]; then
        break
      fi
      i=$((i + 1))
    done
    if [ "$(cat "$marker" 2>/dev/null)" = "2" ]; then
      printf '0\n' > "$marker"
    fi
  ) & disown
}

case "$mode" in
  start)
    if [ "$state" != "1" ]; then
      if start_recording; then
        printf '1\n' > "$marker"
      fi
    fi
    ;;
  stop)
    if [ "$state" = "1" ]; then
      if stop_recording; then
        printf '2\n' > "$marker"
        reset_thinking
      fi
    fi
    ;;
  toggle|*)
    if [ "$state" = "1" ]; then
      if stop_recording; then
        printf '2\n' > "$marker"
        reset_thinking
      fi
    elif [ "$state" = "0" ]; then
      if start_recording; then
        printf '1\n' > "$marker"
      fi
    fi
    ;;
esac