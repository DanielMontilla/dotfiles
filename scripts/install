#!/usr/bin/env bash

set -e

# Check if profile argument is provided
if [ $# -eq 0 ]; then
    echo "Error: Profile argument is required."
    echo "Usage: $0 <profile>"
    echo "Example: $0 framework"
    exit 1
fi

profile="$1"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROFILE_DIR="${REPO_ROOT}/profiles/${profile}"

# Check if profile directory exists
if [ ! -d "$PROFILE_DIR" ]; then
    echo "Error: Profile directory '$PROFILE_DIR' does not exist."
    exit 1
fi

# Determine profile mode from marker files
if [ -f "${PROFILE_DIR}/.nixos" ]; then
    MODE="nixos"
elif [ -f "${PROFILE_DIR}/.nix-profile" ]; then
    MODE="nix-profile"
elif [ -f "${PROFILE_DIR}/.windows" ]; then
    MODE="windows"
else
    echo "Error: Cannot determine mode for profile '$profile' (missing .nixos, .nix-profile, or .windows marker)."
    exit 1
fi

echo "Using profile: $profile (mode: $MODE)"

if [ "$MODE" = "windows" ]; then
    echo "Profile '$profile' is a Windows profile (no nix)."
    echo "Checking prerequisites (dotbot needs Python 3.7+)..."

    # Locate a Python interpreter (python3 preferred, python as fallback)
    PYTHON_CMD=""
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_CMD="python3"
    elif command -v python >/dev/null 2>&1; then
        PYTHON_CMD="python"
    fi

    if [ -z "$PYTHON_CMD" ]; then
        echo "Error: Python 3.7+ is required for dotbot but was not found."
        echo "Install it from https://www.python.org/downloads/ and check 'Add python.exe to PATH'."
        exit 1
    fi

    PY_VERSION="$("$PYTHON_CMD" -c 'import sys; print("{}.{}".format(sys.version_info.major, sys.version_info.minor))')"
    PY_MAJOR="${PY_VERSION%%.*}"
    PY_MINOR="${PY_VERSION#*.}"; PY_MINOR="${PY_MINOR%%.*}"

    if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 7 ]; }; then
        echo "Error: Found Python ${PY_VERSION}, but dotbot requires Python 3.7 or newer."
        exit 1
    fi
    echo "  Python ${PY_VERSION} found."

    if command -v dotbot >/dev/null 2>&1 || "$PYTHON_CMD" -c 'import dotbot' >/dev/null 2>&1; then
        echo "  dotbot already available."
    else
        echo "  dotbot not found — installing it with pip..."
        "$PYTHON_CMD" -m pip install --user dotbot
    fi

    echo "Done. Link config files with: ./scripts/link $profile"
    exit 0
fi

if [ "$MODE" = "nixos" ]; then
    NIXOS_DIR="${REPO_ROOT}/nixos"

    if [ ! -d "$NIXOS_DIR" ]; then
        echo "Error: NixOS directory '$NIXOS_DIR' does not exist."
        exit 1
    fi

    HOST_DIR="${NIXOS_DIR}/hosts/${profile}"
    if [ ! -d "$HOST_DIR" ]; then
        echo "Error: Host directory '$HOST_DIR' does not exist."
        exit 1
    fi

    echo "Rebuilding NixOS configuration..."
    cd "${NIXOS_DIR}"
    sudo nixos-rebuild switch --flake ".#${profile}" "${@:2}"
else
    PROFILE_FLAKE="${PROFILE_DIR}/nixos"

    if [ ! -f "${PROFILE_FLAKE}/flake.nix" ]; then
        echo "Error: Nix profile flake '$PROFILE_FLAKE/flake.nix' does not exist."
        exit 1
    fi

    EXISTING_NAME="$(nix profile list 2>/dev/null | awk -v flake="${PROFILE_FLAKE}" -v pname="${profile}" '
        /Name:/ { name = $2; gsub(/\033\[[0-9;]*m/, "", name) }
        name != "" && (index($0, flake) > 0 || name == pname) { print name; exit }
    ')"

    if [ -n "${EXISTING_NAME}" ]; then
        echo "Updating existing Nix profile '${EXISTING_NAME}'..."
        nix profile upgrade "${EXISTING_NAME}"
    else
        echo "Installing Nix profile '${profile}' for the first time..."
        nix profile add "path:${PROFILE_FLAKE}"
    fi

    # Install WSL config if present
    WSL_CONF="${PROFILE_DIR}/wsl.conf"
    if [ -f "$WSL_CONF" ]; then
        echo "Installing wsl.conf..."
        sudo cp "$WSL_CONF" /etc/wsl.conf
        echo "  → wsl.conf installed. Run 'wsl --shutdown' in PowerShell, then restart this terminal to enable systemd."
    fi

    # Install and enable any systemd services shipped with the profile
    SYSTEMD_DIR="${PROFILE_DIR}/systemd"
    if [ -d "$SYSTEMD_DIR" ]; then
        echo "Installing systemd services..."
        for service in "$SYSTEMD_DIR"/*.service; do
            [ -f "$service" ] || continue
            sudo cp "$service" /etc/systemd/system/
            sudo systemctl enable "$(basename "$service")"
            sudo systemctl start "$(basename "$service")"
        done
    fi
fi
