# SSH over Tailscale mesh (internet, key-only, port 2222)
# Replace <tailnet> with your Tailscale network name (see `tailscale status`).
# Hostnames resolve to stable *.ts.net addresses — no port forwarding needed.

Host olimar
  HostName olimar.tail5c357b.ts.net
  User daniel
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  StrictHostKeyChecking accept-new

# pikpik: macOS work laptop (macOS Remote Login / system sshd, port 22)
Host pikpik
  HostName pikpik.tail5c357b.ts.net
  User danielmontilla
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  StrictHostKeyChecking accept-new
