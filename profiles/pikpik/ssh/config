# SSH over the Tailscale mesh (internet, key-only, port 2222).
#
# This profile uses macOS's /usr/bin/ssh, not nixpkgs openssh: the Apple
# client understands `UseKeychain` and stores the key passphrase in the
# login Keychain. That is why `openssh` is not in nixos/flake.nix.
#
# Tailnet suffix: tail5c357b (same as olimar/louie). Verify with
# `tailscale status` if MagicDNS names ever change.

Host olimar
  HostName olimar.tail5c357b.ts.net
  User daniel
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  UseKeychain yes
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host louie
  HostName louie.tail5c357b.ts.net
  User daniel
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  UseKeychain yes
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
  ServerAliveCountMax 3
