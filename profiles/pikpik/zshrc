# macOS keeps /bin/zsh as the login shell. nix-darwin cannot change the shell
# of an account it did not create — `users.knownUsers` is only for accounts
# nix-darwin owns, and its docs say not to put the admin user there — so the
# account record stays zsh.
#
# Hand interactive zsh to fish instead. Ghostty, Terminal, VS Code, and an
# interactive `ssh` into this Mac all start an interactive zsh, so all of them
# end up in fish. Non-interactive shells (`zsh -c ...`, scripts) are untouched.
if [[ -o interactive ]] && [[ -z $FISH_VERSION ]] && [[ -x /run/current-system/sw/bin/fish ]]; then
    exec /run/current-system/sw/bin/fish
fi
